# ===============================================
# Grade Portal - Frontend Environment Variables
# ===============================================
# Copy this file to .env and .env.production
# Different values for development, staging, and production

# ===== API CONFIGURATION =====
# Backend API base URL (must include /api/v1)
# Development: http://localhost:8000/api/v1
# Production: https://api.yourdomain.com/api/v1
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1

# ===== PRODUCTION MODE ENFORCEMENT =====
# CRITICAL: Set to 'true' in production builds
# When true: No localStorage fallback for enrollment/profile data
# When true: All data must come from API or fail gracefully
# REQUIRED for production deployment
# Default: 'false' (allows development with localStorage fallback)
REACT_APP_USE_API_ONLY=false

# ===== OPTIONAL: Google reCAPTCHA =====
# Get site key from: https://www.google.com/recaptcha/admin
REACT_APP_RECAPTCHA_SITE_KEY=

# ===== OPTIONAL: Google Analytics =====
# REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X

# ===== OPTIONAL: Feature Flags =====
# REACT_APP_ENABLE_CHATBOT=true
# REACT_APP_ENABLE_FORECASTING=true
# REACT_APP_ENABLE_RECOMMENDATIONS=true

# ===== PRODUCTION BUILD REQUIREMENTS =====
# For production deployment:
# 1. Set REACT_APP_API_BASE_URL to production API URL with HTTPS
# 2. Set REACT_APP_USE_API_ONLY=true (CRITICAL - no localStorage fallback)
# 3. Run: npm run build
# 4. Deploy dist/ folder to static hosting
# 5. Configure CORS on backend to allow your frontend domain
#
# Production Build Command:
# REACT_APP_API_BASE_URL=https://api.yourdomain.com/api/v1 \
# REACT_APP_USE_API_ONLY=true \
# npm run build
#
# ===== DEPLOYMENT OPTIONS =====
# 1. Vercel: Auto-deploys on git push, handles env vars
# 2. Netlify: Similar to Vercel, excellent React support
# 3. GitHub Pages: Static hosting for free tier
# 4. Nginx: Manual deployment with reverse proxy
# 5. AWS S3 + CloudFront: Scalable static hosting
# 6. Heroku: Full-stack deployment with buildpacks
#
# ===== NGINX CONFIGURATION EXAMPLE =====
