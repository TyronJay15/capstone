# ===============================================
# Grade Portal - Backend Environment Variables
# ===============================================
# Copy this file to .env and update with your values
# PRODUCTION DEPLOYMENT: Use strong, randomly-generated values

# ===== CRITICAL SECURITY SETTINGS =====
# Generate SECRET_KEY using: python manage.py shell
# >>> from django.core.management.utils import get_random_secret_key
# >>> print(get_random_secret_key())
SECRET_KEY=change-me-to-a-long-random-string

# NEVER set to True in production
DEBUG=False

# PRODUCTION: List all allowed hostnames/domains (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# ===== DATABASE CONFIGURATION =====
# Production should use MySQL (not SQLite)
USE_SQLITE=false

# Option 1: Use DATABASE_URL (recommended for managed hosting)
# Format: mysql://user:password@hostname:port/dbname
DATABASE_URL=

# Option 2: Individual MySQL configuration (if not using DATABASE_URL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gradeportal
MYSQL_USER=gradeportal
MYSQL_PASSWORD=

# ===== DJANGO SETTINGS MODULE =====
# Production: Use config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.production

# ===== CORS - Cross-Origin Resource Sharing =====
# Production: List only your frontend domain(s)
# NEVER use "*" in production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== JWT AUTHENTICATION =====
# How long access tokens remain valid (minutes)
JWT_ACCESS_MINUTES=60

# How long refresh tokens remain valid (days)
JWT_REFRESH_DAYS=7

# ===== SECURITY - SSL/TLS =====
# Production MUST use HTTPS with secure cookies
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# ===== API RATE LIMITING =====
# Format: "requests/time_period" (e.g., "100/hour", "1000/day")
# Protects against brute force and DoS attacks
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour

# ===== EXTERNAL SERVICES =====
# Google reCAPTCHA v3 for enrollment form protection
RECAPTCHA_SECRET_KEY=

# ===== OPTIONAL: Email Configuration =====
# Uncomment and configure for production email support
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password

# ===== OPTIONAL: Redis Cache =====
# For caching and session storage (improves performance)
# REDIS_URL=redis://localhost:6379/0

# ===== LOGGING =====
LOG_LEVEL=INFO
# LOG_FILE=/var/log/gradeportal/django.log

# ===== PRODUCTION DEPLOYMENT NOTES =====
# 1. Generate SECRET_KEY with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 2. Set DEBUG=False
# 3. Use strong, unique MYSQL_PASSWORD
# 4. Configure CORS_ALLOWED_ORIGINS with your actual domain
# 5. Use DATABASE_URL for managed hosting (Railway, Render, etc.)
# 6. Set ALLOWED_HOSTS to your domain(s) only
# 7. Use environment variables instead of .env file in production
# 8. Run: python manage.py collectstatic --noinput
# 9. Run: python manage.py migrate
# 10. Use Gunicorn + Nginx in production, not Django development server

# ===== HOSTING PLATFORM GUIDES =====
# Railway: https://docs.railway.app/guides/django
# Render: https://render.com/docs/deploy-django
# DigitalOcean: https://www.digitalocean.com/community/tutorials/how-to-set-up-django-with-postgres-nginx-and-gunicorn-on-ubuntu
# AWS: https://docs.aws.amazon.com/elasticbeanstalk/latest/dg/create-deploy-python-flask.html
# Hetzner: https://docs.hetzner.cloud/tutorials
